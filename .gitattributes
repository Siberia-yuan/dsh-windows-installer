# Windows batch files MUST be CRLF - cmd.exe parses multi-line blocks and
# goto labels unreliably with LF-only line endings (symptom: script exits
# immediately with no output). This also makes GitHub's zip download
# produce CRLF files.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.vbs  text eol=crlf

# everything else: LF as-is
*.mjs  text eol=lf
*.cjs  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.txt  text eol=lf
*.html text eol=lf
*.svg  text eol=lf

# binary
*.ico  binary
