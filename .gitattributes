# Windows batch/script files MUST be CRLF. cmd.exe parses multi-line blocks
# and goto labels unreliably with LF-only endings (symptom: script exits
# immediately with no output).
#
# We use `-text` (store as-is, no line-ending normalization) so the repo
# blob itself is CRLF: git checkout, GitHub's zip download and raw files
# all deliver CRLF. (`text eol=crlf` would store LF in the blob and rely on
# checkout conversion, which GitHub's zip download does NOT apply.)
*.cmd  -text
*.bat  -text
*.ps1  -text
*.vbs  -text

# everything else: normalize to LF in the blob
*.mjs  text eol=lf
*.cjs  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.txt  text eol=lf
*.html text eol=lf
*.svg  text eol=lf

# binary
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
